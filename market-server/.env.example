# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ==========================================
# SUPABASE & POSTGRESQL CONFIGURATION
# ==========================================
# Direct PostgreSQL Connection String (Transaction or Session Pooler / Direct URI)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DB_POOL_MAX=20

# Supabase Project URL & Keys
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase JWT Secret (Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ==========================================
# MARKET ENGINE CONFIGURATION
# ==========================================
# Currency unit scale: 100 = 2 decimal places (cents/sen), 1 = integer Rupiah/Dollar
PRICE_SCALE=100
DEFAULT_STARTING_BALANCE=10000000
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=50
ALLOW_DEV_HEADER_AUTH=false

